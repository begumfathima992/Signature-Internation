# Backend base URL for the contact form. Leave empty to use mock mode (the form has no backend yet).
VITE_API_URL=
# Address of the Node API in /server (services list and admin area). Leave empty locally:
# Vite forwards /api to http://localhost:4000. In production, e.g. https://api.your-domain.com
VITE_SERVER_URL=
# Live site address, used for sitemap.xml, robots.txt and Open Graph image URLs.
VITE_SITE_URL=
# Set to true to show the Google Maps embed (also set company.map.embedUrl).
VITE_ENABLE_MAP=
