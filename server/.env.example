# Copy to server/.env and fill in. Never commit real values.

# PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/signature_dev

# Long random string that signs login tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Site address(es) allowed to call the API, comma separated.
SITE_ORIGIN=http://localhost:5174

PORT=4000
NODE_ENV=development

# Number of proxies in front of the API: 0 locally, 1 on Render, so the real visitor IP is logged and rate limited.
TRUST_PROXY=0

# How many admins can have access at once (default 2).
MAX_ADMINS=2

# The first admin account, created once by npm run db:seed when the site is set up (password 12+ characters).
# After that, admins invite each other from the Admins page; nobody needs to edit this file.
# ADMIN2_* is optional: leave it empty to invite the second admin from the site instead.
ADMIN1_NAME=First Admin
ADMIN1_EMAIL=admin1@example.com
ADMIN1_PASSWORD=replace-with-a-strong-password
ADMIN2_NAME=
ADMIN2_EMAIL=
ADMIN2_PASSWORD=
